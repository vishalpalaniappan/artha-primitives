{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./narrative.schema.json",
    "title": "narrative-schema",
    "description": "A schema for the narratives.",
    "type": "object",
    "required": [
        "metadata",
        "narrative"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "metadata": {
            "type": "string"
        },
        "narrative": {
            "type": "array",
            "items": {
                "anyOf": [
                    { "$ref": "#/definitions/import" },
                    { "$ref": "#/definitions/participant" },
                    { "$ref": "#/definitions/behavior" }
                ]
            }
        }
    },
    "definitions": {}
}