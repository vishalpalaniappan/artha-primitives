{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./behavior.schema.json",
    "title": "BehaviorSchema",
    "description": "A schema for a behavior in a narrative.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string",
            "const": "behavior"
        },
        "behaviorName": {
            "type": "string"
        },
        "body": {
            "type": "array"
        },
        "attributes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "value"],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "required": [
        "attributes",
        "body",
        "name",
        "behaviorName"
    ]
}