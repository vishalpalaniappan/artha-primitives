{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/behavior.schema.json",
    "title": "behavior-schema",
    "description": "A schema for a behavior in a narrative.",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "const": "behavior"
        },
        "name": {
            "type": "string"
        },
        "body": {
            "type": "array"
        },
        "attributes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "value"],
                "properties": {
                "name": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
                },
                "additionalProperties": false
            }
        }
    },
    "required": [
        "attributes",
        "body",
        "name",
        "type"
    ]
}