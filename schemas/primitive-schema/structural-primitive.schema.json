{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/structural-primitive.schema.json",
    "title": "StructuralPrimitive",
    "description": "A schema definition for structural-primitve files. These files are used to establish the structure of the meaning by importing files, defining participants, behaviors etc.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URI reference to the JSON schema."
        },
        "name": {
            "type": "string",
            "description": "The unique identifier name of the structural-primitive and is also the syntax used to invoke the primitive."
        },
        "type": {
            "type": "string",
            "enum": [
                "structural-primitive"
            ],
            "description": "The primitive type."
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version string (e.g., 1.0.0)."
        },
        "description": {
            "type": "string",
            "description": "The description of the primitive."
        },
        "attributes": {
            "type": "array",
            "description": "The attributes for this primitive",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The name of the parameter."
                    },
                    "aliasStructuralType": {
                        "type" : "string",
                        "description": "Structural type of the alias."
                    },
                    "attributeStructuralType": {
                        "type" : "string",
                        "description": "Structural type of the attribute."
                    },
                    "required": {
                        "type": "boolean",
                        "description": "Indicates if this attribute is required for the primitive.",
                        "default": false
                    }
                },
                "if": {
                    "properties": {
                        "name": {
                            "const": "alias"
                        }
                    },
                    "required": ["name"]
                },
                "then": {
                    "properties": { 
                        "aliasStructuralType": { 
                            "type": "string" 
                        } 
                    },
                    "required": ["aliasStructuralType"]
                },
                "required": ["attributeStructuralType", "name", "required"],
                "additionalProperties": false
            }
        },
        "_note": {
            "type": "string",
            "description": "Add optional note for primitive."
        }
    },
    "required": [
        "name",
        "type",
        "version",
        "description",
        "attributes"
    ]
}