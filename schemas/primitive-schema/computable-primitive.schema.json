{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/computable-primitive.schema.json",
    "title": "ComputablePrimitiveSchema",
    "description": "A schema definition for computable-primitive files.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URI reference to the JSON schema."
        },
        "name": {
            "type": "string",
            "description": "The unique identifier name of the computable-primitive and is also the syntax used to invoke the primitive."
        },
        "type": {
            "type": "string",
            "enum": [
                "computable-primitive"
            ],
            "description": "The primitive type."
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version string (e.g., 1.0.0)."
        },
        "description": {
            "type": "string",
            "description": "The description of the primitive."
        },
        "attributes": {
            "type": "object",
            "description": "The attributes in this primitive",
            "properties": {
                "alias": {
                    "type": "object",
                    "description": "The optional alias for the primitive.",
                    "properties": {
                        "aliasStructuralType": {
                            "type": "string",
                            "description": "Structural type of the alias."
                        }
                    },
                    "required": [
                        "aliasStructuralType"
                    ]                    
                },
                "args": {
                    "type": "array",
                    "description": "The attributes in this primitive",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "The name of the parameter."
                            },
                            "attributeStructuralType": {
                                "type": "string",
                                "description": "The structural type of the attribute."
                            },
                            "description": {
                                "type": "string"
                            },
                            "required": {
                                "type": "boolean",
                                "description": "Indicates if this attribute is required for the primitive.",
                                "default": false
                            },
                            "checkExistence": {
                                "type": "boolean",
                                "description": "Indicates if the validator should check for the existence of this alias.",
                                "default": false
                            }
                        }
                    }
                }
            },
            "required": [
                "args"
            ]
        },
        "_note": {
            "type": "string",
            "description": "Add optional note for primitive."
        },
        "invariants": {
            "type": "array",
            "description": "The invariants for this primitive",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique id for the invariant"
                    },
                    "participants": {
                        "type": "array",
                        "description": "The participants in this invariant.",
                        "items": {
                            "type": "string"
                        }
                    },
                    "property": {
                        "type": "string",
                        "description": "The properties involved in this invariant."
                    },
                    "condition": {
                        "type": "array",
                        "description": "The participants in this invariant.",
                        "items": {
                            "type": "string"
                        }
                    },
                    "description": {
                        "type": "string",
                        "description": "The description of the invariant."
                    },
                    "invalidValues": {
                        "type": "array",
                        "description": "Invalid values used to test this invariant.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string"
                                },
                                "description": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "value",
                                "description"
                            ]
                        }
                    }
                },
                "required": [
                    "id",
                    "participants",
                    "property",
                    "condition",
                    "description",
                    "invalidValues"
                ]
            }
        },
        "modifies": {
            "type": "object",
            "patternProperties": {
                 "^.+$": {
                    "type": "object",
                    "required": [
                        "operation",
                        "value"
                    ],
                    "properties": {
                        "operation": {
                            "type": "string"
                        },
                        "value": {}
                    },
                    "additionalProperties": true
                }
            }
        }
    },
    "required": [
        "name",
        "type",
        "version",
        "description",
        "attributes",
        "invariants"
    ]
}