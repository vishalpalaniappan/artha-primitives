{
    "name": "artha-primitives",
    "version": "0.0.0",
    "type": "module",
    "description": "Schema documentation for Artha primitives.",
    "main": "./src/index.js",
    "scripts": {
        "install:all": "npm install && cd docs && npm install",
        "generate-documentation": "node ./generate-docs.js",
        "docusaurus": "npm run generate-documentation && cd docs && npx docusaurus",
        "start": "npm run generate-documentation && cd docs && npx docusaurus start",
        "build": "npm run generate-documentation && cd docs && npx docusaurus build",
        "serve": "cd docs && npm run serve",
        "deploy": "npm run build && gh-pages -d docs/build",
        "generate-schema": "node ./src/schema_generator/generateSchemas.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vishalpalaniappan/artha-primitives.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/vishalpalaniappan/artha-primitives/issues"
    },
    "homepage": "https://github.com/vishalpalaniappan/artha-primitives#readme",
    "dependencies": {
        "@apidevtools/json-schema-ref-parser": "^15.5.2",
        "ajv": "^8.20.0",
        "docusaurus-plugin-image-zoom": "^3.0.1",
        "json-schema-static-docs": "^0.28.1"
    },
    "devDependencies": {
        "gh-pages": "^6.3.0"
    }
}
