{
    "$schema": "../../schemas/meta-primitive.schema.json",
    "name": "import",
    "version": "0.0.0",
    "type": "meta-primitive",
    "description":"Imports file into meaning (artha, txt, json etc) and provides optional alias. The alias will be useful for cases where a JSON file is imported and used in the files meaning.",
    "syntax": "import",
    "attributes": [
        {
            "name": "file",
            "attributeStructuralType": "string",
            "required": true
        },
        {
            "name": "alias",
            "attributeStructuralType": "string",
            "aliasStructuralType": "inherit",
            "required": true
        }
    ]
}