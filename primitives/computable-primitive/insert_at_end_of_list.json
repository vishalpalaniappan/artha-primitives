{
    "$schema":"../../schemas/primitive-schema/computable-primitive.schema.json",
    "name": "insert_at_end_of_list",
    "version": "0.0.0",
    "type": "computable-primitive",
    "description":"Inserts item to end of list.",
    "participants": [
        {
            "name": "item",
            "index": 0,
            "required": true
        },
        {
            "name": "list",
            "index": 1,
            "required": true
        }
    ],
    "invariants": [
        {
            "id": "1",
            "participants": ["list"],
            "property": "structural_type",
            "condition": ["list"],
            "description": "list must have structural_type List.",
            "invalidValues": [
                {
                    "value": "string_value",
                    "description": "A string is provided as list participant"
                }
            ]
        }
    ]
}