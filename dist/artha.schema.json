{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./narrative.schema.json",
  "title": "narrative-schema",
  "description": "A schema for the narratives.",
  "type": "object",
  "required": [
    "metadata",
    "narrative"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "string"
    },
    "narrative": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "properties": {
              "type": {
                "const": "import"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "./structural-primitive.schema.json",
            "title": "ImportSchema",
            "description": "A schema definition for import meaning.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name",
              "file",
              "alias"
            ]
          },
          {
            "properties": {
              "type": {
                "const": "participant"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "./participant.schema.json",
            "title": "ParticipantSchema",
            "description": "A schema for a participant in a narrative.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "body",
              "name",
              "type"
            ]
          },
          {
            "properties": {
              "type": {
                "const": "behavior"
              }
            },
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "./behavior.schema.json",
            "title": "BehaviorSchema",
            "description": "A schema for a behavior in a narrative.",
            "type": "object",
            "required": [
              "attributes",
              "body",
              "name",
              "type"
            ]
          }
        ]
      }
    }
  },
  "definitions": {
    "import": {
      "properties": {
        "type": {
          "const": "import"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "./structural-primitive.schema.json",
      "title": "ImportSchema",
      "description": "A schema definition for import meaning.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "file",
        "alias"
      ]
    },
    "participant": {
      "properties": {
        "type": {
          "const": "participant"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "./participant.schema.json",
      "title": "ParticipantSchema",
      "description": "A schema for a participant in a narrative.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "name",
        "type"
      ]
    },
    "behavior": {
      "properties": {
        "type": {
          "const": "behavior"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "./behavior.schema.json",
      "title": "BehaviorSchema",
      "description": "A schema for a behavior in a narrative.",
      "type": "object",
      "required": [
        "attributes",
        "body",
        "name",
        "type"
      ]
    }
  }
}