{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./structural_type-structure.schema.json",
    "title": "structural_type",
    "description": "Structural schema for structural_type primitive.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "args"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URI reference to the JSON schema."
        },
        "name": {
            "type": "string",
            "description": "Name of the primitive.",
            "const": "structural_type"
        },
        "id": {
            "type": "string"
        },
        "primitiveType": {
            "type": "string",
            "description": "Type of the primitive.",
            "const": "meta-primitive"
        },
        "alias": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "aliasName"
            ],
            "properties": {
                "aliasName": {
                    "type": "string"
                },
                "introduce": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "args": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
                {
                    "type": "object",
                    "properties": {
                        "argName": {
                            "type": "string",
                            "const": "value"
                        },
                        "value": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "argName",
                        "value"
                    ],
                    "additionalProperties": false
                }
            ]
        }
    }
}