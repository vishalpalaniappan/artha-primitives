{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./get_length.schema.json",
    "title": "get_length",
    "description": "Structural schema for get_length primitive.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "args"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URI reference to the JSON schema."
        },
        "name": {
            "type": "string",
            "description": "Name of the primitive.",
            "const": "get_length",
            "x-invariant-metadata": [
                {
                    "id": "1",
                    "participants": [
                        "list"
                    ],
                    "property": "structural_type",
                    "condition": [
                        "list"
                    ],
                    "description": "list must have structural_type List.",
                    "invalidValues": [
                        {
                            "value": "string_value",
                            "description": "A string is provided as list participant"
                        }
                    ]
                }
            ]
        },
        "id": {
            "type": "string"
        },
        "primitiveType": {
            "type": "string",
            "description": "Type of the primitive.",
            "const": "computable-primitive"
        },
        "args": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
                {
                    "type": "object",
                    "properties": {
                        "argName": {
                            "type": "string",
                            "const": "list"
                        },
                        "argType": {
                            "type": "string",
                            "description": "Type of arg value (name or const).",
                            "enum": [
                                "name",
                                "const"
                            ]
                        },
                        "value": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "argName",
                        "value",
                        "argType"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "alias": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "aliasName"
            ],
            "properties": {
                "aliasName": {
                    "type": "string"
                },
                "aliasStructuralType": {
                    "type": "string",
                    "const": "int"
                },
                "introduce": {
                    "type": "boolean",
                    "default": false
                }
            }
        }
    }
}