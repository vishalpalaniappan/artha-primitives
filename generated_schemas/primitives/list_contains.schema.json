{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./list_contains.schema.json",
    "title": "list_contains",
    "description": "Structural schema for list_contains primitive.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "args"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URI reference to the JSON schema."
        },
        "name": {
            "type": "string",
            "description": "Name of the primitive.",
            "const": "list_contains"
        },
        "id": {
            "type": "string"
        },
        "primitiveType": {
            "type": "string",
            "description": "Type of the primitive.",
            "const": "meta-primitive"
        },
        "args": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
                {
                    "type": "object",
                    "properties": {
                        "argName": {
                            "type": "string",
                            "const": "value"
                        },
                        "value": {
                            "type": "array"
                        }
                    },
                    "required": [
                        "argName",
                        "value"
                    ],
                    "additionalProperties": false
                }
            ]
        }
    }
}