{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./initial_value-structure.schema.json",
    "title": "initial_value",
    "description": "Structural schema for initial_value primitive.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URI reference to the JSON schema."
        },
        "name": {
            "type": "string",
            "description": "Name of the primitive.",
            "const": "initial_value"
        },
        "id": {
            "type": "string"
        },
        "primitiveType": {
            "type": "string",
            "description": "Type of the primitive.",
            "const": "meta-primitive"
        },
        "value": {}
    },
    "required": [
        "name",
        "value"
    ]
}