{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./yield-structure.schema.json",
    "title": "yield-primitive-structure-schema",
    "description": "Structural schema for yield primitive.",
    "primitiveType": "meta-primitive",
    "type": "object",
    "name": "yield",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URI reference to the JSON schema."
        },
        "name": {
            "type": "string",
            "description": "Name of the primitive."
        },
        "invariant": {
            "x-custom-rule": "validate-narrative"
        },
        "alias": {}
    },
    "required": [
        "name",
        "alias"
    ]
}