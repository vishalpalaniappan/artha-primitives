{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./yield.schema.json",
    "title": "yield",
    "description": "Structural schema for yield primitive.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "args"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URI reference to the JSON schema."
        },
        "name": {
            "type": "string",
            "description": "Name of the primitive.",
            "const": "yield"
        },
        "id": {
            "type": "string"
        },
        "primitiveType": {
            "type": "string",
            "description": "Type of the primitive.",
            "const": "meta-primitive"
        },
        "args": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
                {
                    "type": "object",
                    "properties": {
                        "argName": {
                            "type": "string",
                            "const": "alias"
                        },
                        "argType": {
                            "type": "string",
                            "description": "Type of arg value (name or const)."
                        },
                        "value": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "argName",
                        "value",
                        "argType"
                    ],
                    "additionalProperties": false
                }
            ]
        }
    }
}