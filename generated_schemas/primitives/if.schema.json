{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./if-structure.schema.json",
    "title": "if-primitive-structure-schema",
    "description": "Structural schema for if primitive.",
    "primitiveType": "functional-primitive",
    "type": "object",
    "name": "if",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URI reference to the JSON schema."
        },
        "name": {
            "type": "string",
            "description": "Name of the primitive."
        },
        "invariant": {
            "x-custom-rule": "validate-narrative",
            "x-meta-data": [
                {
                    "id": "inv_1",
                    "participants": [
                        "condition"
                    ],
                    "property": "structuralType",
                    "condition": [
                        "boolean"
                    ],
                    "description": "the condition must be a boolean value",
                    "invalidValues": [
                        {
                            "value": "string_value",
                            "description": "A string is provided as the condition"
                        }
                    ]
                }
            ]
        },
        "condition": {}
    },
    "required": [
        "name",
        "condition"
    ]
}