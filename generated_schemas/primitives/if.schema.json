{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./if.schema.json",
    "title": "if",
    "description": "Structural schema for if primitive.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "args",
        "body"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URI reference to the JSON schema."
        },
        "name": {
            "type": "string",
            "description": "Name of the primitive.",
            "const": "if",
            "x-invariant-metadata": [
                {
                    "id": "inv_1",
                    "participants": [
                        "condition"
                    ],
                    "property": "structuralType",
                    "condition": [
                        "boolean"
                    ],
                    "description": "the condition must be a boolean value",
                    "invalidValues": [
                        {
                            "value": "string_value",
                            "description": "A string is provided as the condition"
                        }
                    ]
                }
            ]
        },
        "id": {
            "type": "string"
        },
        "primitiveType": {
            "type": "string",
            "description": "Type of the primitive.",
            "const": "functional-primitive"
        },
        "args": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
                {
                    "type": "object",
                    "properties": {
                        "argName": {
                            "type": "string",
                            "const": "condition"
                        },
                        "argType": {
                            "type": "string",
                            "description": "Type of arg value (name or const)."
                        },
                        "value": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "argName",
                        "value",
                        "argType"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "body": {
            "type": "array"
        }
    }
}