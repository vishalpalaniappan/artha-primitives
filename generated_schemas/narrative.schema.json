{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "./narrative.schema.json",
    "title": "narrative-schema",
    "description": "A schema for the narratives.",
    "type": "object",
    "required": [
        "metadata",
        "initialBehavior",
        "narrative"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "metadata": {
            "type": "string"
        },
        "id": {
            "type": "string"
        },
        "initialBehavior": {
            "type": "string"
        },
        "narrative": {
            "$ref": "#/$defs/recursiveObjectCheck"
        }
    },
    "$defs": {
        "recursiveObjectCheck": {
            "anyOf": [
                {
                    "type": "object",
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "behavior"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./structural-schema/behavior.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "invoke"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./structural-schema/invoke.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "participant"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./structural-schema/participant.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "import"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./structural-schema/import.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "terminal_display"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/terminal_display.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "terminal_input"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/terminal_input.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "clear_list"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/clear_list.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "equals"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/equals.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "insert_at_end_of_list"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/insert_at_end_of_list.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "if"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/if.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "initial_value"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/initial_value.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "introduce"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/introduce.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "list_contains"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/list_contains.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "structural_type"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/structural_type.schema.json"
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "name": {
                                        "const": "yield"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            },
                            "then": {
                                "$ref": "./primitives/yield.schema.json"
                            }
                        }
                    ],
                    "properties": {
                        "items": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/recursiveObjectCheck"
                            }
                        }
                    },
                    "additionalProperties": {
                        "$ref": "#/$defs/recursiveObjectCheck"
                    }
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/recursiveObjectCheck"
                    }
                },
                {
                    "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                    ]
                }
            ]
        }
    },
    "manifest": {
        "$schema": "./manifest.schema.json",
        "primitiveTypes": [
            "computable-primitive",
            "functional-primitive",
            "computable-legacy-primitive",
            "meta-primitive"
        ],
        "structuralTypes": [
            "behavior",
            "participant",
            "import",
            "invoke"
        ],
        "structure": {
            "behavior": {
                "contains": {
                    "computable-primitive": {
                        "excludes": []
                    },
                    "computable-legacy-primitive": {
                        "excludes": []
                    },
                    "functional-primitive": {
                        "excludes": []
                    },
                    "meta-primitive": {
                        "excludes": [
                            "list_contains",
                            "structural_type"
                        ]
                    }
                }
            },
            "participant": {
                "contains": {
                    "meta-primitive": {
                        "excludes": [
                            "introduce",
                            "yield"
                        ]
                    }
                }
            },
            "import": {}
        }
    }
}